{
  "name": "subtitle-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop video player with interactive Burmese subtitle translation.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:app": "electron-vite build",
    "package:win": "npm run build && node scripts/package-windows.mjs && node scripts/build-windows-setup.mjs",
    "preview": "electron-vite preview",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dictionary:verify-production": "node scripts/verify-production-dictionary.mjs",
    "dictionary:validate": "node scripts/dictionary-tool.mjs validate src/main/translation/data/dictionary.json",
    "dictionary:build": "node scripts/dictionary-tool.mjs build dictionary/batches dictionary/generated/dictionary.json",
    "check": "npm run lint && npm run typecheck && npm run dictionary:verify-production && npm run dictionary:validate && npm run test && npm run build:app"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^36.3.2",
    "electron-vite": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
